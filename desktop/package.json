{
  "name": "nexus-school-desktop",
  "productName": "Nexus School Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Windows desktop client for Nexus School Management SaaS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:windows": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nexusschool.desktop",
    "productName": "Nexus School Desktop",
    "files": ["main.js", "security.js", "package.json"],
    "directories": {"output": "dist"},
    "win": {"target": ["nsis"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true},
    "linux": {"target": ["AppImage"], "category": "Education"}
  }
}
